{
  "sdkPackage": "@cline/sdk",
  "sdkVersion": "0.0.43",
  "cases": [
    {
      "name": "text delta",
      "input": { "type": "agent_event", "payload": { "sessionId": "session-1", "event": { "type": "content_delta", "contentType": "text", "delta": "hello" } } },
      "expected": { "type": "agent_event", "sessionId": "session-1", "event": { "type": "TextDelta", "sessionId": "session-1", "text": "hello", "accumulated": "", "phase": "update", "raw": { "type": "content_delta", "contentType": "text", "delta": "hello" } }, "payload": { "sessionId": "session-1", "event": { "type": "content_delta", "contentType": "text", "delta": "hello" } } }
    },
    {
      "name": "completed tool call",
      "input": { "type": "agent_event", "payload": { "sessionId": "session-2", "event": { "type": "content_end", "contentType": "tool", "toolName": "read_file", "input": { "path": "README.md" }, "output": { "text": "done" }, "iteration": 3 } } },
      "expected": { "type": "agent_event", "sessionId": "session-2", "event": { "type": "ToolCallCompleted", "sessionId": "session-2", "toolName": "read_file", "input": { "path": "README.md" }, "output": { "text": "done" }, "error": "", "iteration": 3, "raw": { "type": "content_end", "contentType": "tool", "toolName": "read_file", "input": { "path": "README.md" }, "output": { "text": "done" }, "iteration": 3 } }, "payload": { "sessionId": "session-2", "event": { "type": "content_end", "contentType": "tool", "toolName": "read_file", "input": { "path": "README.md" }, "output": { "text": "done" }, "iteration": 3 } } }
    },
    {
      "name": "session snapshot usage",
      "input": { "type": "session_snapshot", "payload": { "sessionId": "session-3", "snapshot": { "status": "running", "model": { "modelId": "model-1" }, "aggregateUsage": { "inputTokens": 10, "outputTokens": 4 } } } },
      "expected": { "type": "session_snapshot", "sessionId": "session-3", "status": "running", "modelId": "model-1", "usage": { "inputTokens": 10, "outputTokens": 4 }, "payload": { "sessionId": "session-3", "snapshot": { "status": "running", "model": { "modelId": "model-1" }, "aggregateUsage": { "inputTokens": 10, "outputTokens": 4 } } } }
    },
    {
      "name": "unknown future event",
      "input": { "type": "sdk_future_event", "payload": { "sessionId": "session-4", "value": 1 } },
      "expected": { "type": "unknown", "originalType": "sdk_future_event", "payload": { "sessionId": "session-4", "value": 1 } }
    }
  ]
}
