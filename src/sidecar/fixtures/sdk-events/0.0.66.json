{
  "sdkPackage": "@cline/sdk",
  "sdkVersion": "0.0.66",
  "cases": [
    {
      "name": "text delta",
      "input": { "type": "agent_event", "payload": { "sessionId": "session-1", "event": { "type": "content_delta", "contentType": "text", "delta": "hello" } } },
      "expected": { "type": "agent_event", "sessionId": "session-1", "event": { "type": "TextDelta", "sessionId": "session-1", "text": "hello", "accumulated": "", "phase": "update", "raw": { "type": "content_delta", "contentType": "text", "delta": "hello" } }, "payload": { "sessionId": "session-1", "event": { "type": "content_delta", "contentType": "text", "delta": "hello" } } }
    },
    {
      "name": "completed tool call",
      "input": { "type": "agent_event", "payload": { "sessionId": "session-2", "event": { "type": "content_end", "contentType": "tool", "toolName": "read_files", "input": { "files": [{ "path": "README.md" }] }, "output": { "text": "done" }, "iteration": 3 } } },
      "expected": { "type": "agent_event", "sessionId": "session-2", "event": { "type": "ToolCallCompleted", "sessionId": "session-2", "toolName": "read_files", "input": { "files": [{ "path": "README.md" }] }, "output": { "text": "done" }, "error": "", "iteration": 3, "raw": { "type": "content_end", "contentType": "tool", "toolName": "read_files", "input": { "files": [{ "path": "README.md" }] }, "output": { "text": "done" }, "iteration": 3 } }, "payload": { "sessionId": "session-2", "event": { "type": "content_end", "contentType": "tool", "toolName": "read_files", "input": { "files": [{ "path": "README.md" }] }, "output": { "text": "done" }, "iteration": 3 } } }
    },
    {
      "name": "manual compaction progress notice",
      "input": { "type": "agent_event", "payload": { "sessionId": "session-3", "event": { "type": "notice", "message": "compacting", "reason": "manual_compaction", "kind": "manual_compaction", "phase": "started" } } },
      "expected": { "type": "agent_event", "sessionId": "session-3", "event": { "type": "NoticeReceived", "sessionId": "session-3", "message": "compacting", "reason": "manual_compaction", "noticeType": "status", "raw": { "type": "notice", "message": "compacting", "reason": "manual_compaction", "kind": "manual_compaction", "phase": "started" } }, "payload": { "sessionId": "session-3", "event": { "type": "notice", "message": "compacting", "reason": "manual_compaction", "kind": "manual_compaction", "phase": "started" } } }
    },
    {
      "name": "run failure remains model-visible",
      "input": { "type": "agent_event", "payload": { "sessionId": "session-4", "event": { "type": "run-failed", "reason": "tool input validation failed" } } },
      "expected": { "type": "agent_event", "sessionId": "session-4", "event": { "type": "RunFailed", "sessionId": "session-4", "reason": "tool input validation failed", "raw": { "type": "run-failed", "reason": "tool input validation failed" } }, "payload": { "sessionId": "session-4", "event": { "type": "run-failed", "reason": "tool input validation failed" } } }
    },
    {
      "name": "session snapshot usage",
      "input": { "type": "session_snapshot", "payload": { "sessionId": "session-5", "snapshot": { "status": "running", "model": { "modelId": "model-1" }, "aggregateUsage": { "inputTokens": 10, "outputTokens": 4 } } } },
      "expected": { "type": "session_snapshot", "sessionId": "session-5", "status": "running", "modelId": "model-1", "usage": { "inputTokens": 10, "outputTokens": 4 }, "payload": { "sessionId": "session-5", "snapshot": { "status": "running", "model": { "modelId": "model-1" }, "aggregateUsage": { "inputTokens": 10, "outputTokens": 4 } } } }
    },
    {
      "name": "unknown future event",
      "input": { "type": "sdk_future_event", "payload": { "sessionId": "session-6", "value": 1 } },
      "expected": { "type": "unknown", "originalType": "sdk_future_event", "payload": { "sessionId": "session-6", "value": 1 } }
    }
  ]
}
