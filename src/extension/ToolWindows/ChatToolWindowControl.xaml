<UserControl x:Class="VsClineAgent.ToolWindows.ChatToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="400"
            Background="#1E1E1E"
            UseLayoutRounding="True"
            SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Storyboard x:Key="LoadingAnimationStoryboard">
            <DoubleAnimation Storyboard.TargetName="loadingOrbitRotation"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360"
                             Duration="0:0:6"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="loadingLogoHalo"
                             Storyboard.TargetProperty="Opacity"
                             From="0.22" To="0.62"
                             Duration="0:0:1.8"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="loadingLogoGlowEffect"
                             Storyboard.TargetProperty="Opacity"
                             From="0.18" To="0.42"
                             Duration="0:0:1.8"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="loadingTitleGlowEffect"
                             Storyboard.TargetProperty="Opacity"
                             From="0.12" To="0.30"
                             Duration="0:0:2.2"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
        </Storyboard>
    </UserControl.Resources>
    <Grid>
        <wv2:WebView2 x:Name="webView" Visibility="Collapsed" />

        <StackPanel x:Name="loadingPanel"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <Grid Width="152"
                  Height="152"
                  Margin="0,0,0,16">
                <Ellipse x:Name="loadingOrbitRing"
                         Width="144"
                         Height="144"
                         Stroke="#2B9AD6"
                         StrokeThickness="1.5"
                         StrokeDashArray="2 7"
                         StrokeDashCap="Round"
                         Opacity="0.62"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="loadingOrbitRotation" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Effect>
                        <DropShadowEffect x:Name="loadingOrbitGlowEffect"
                                          Color="#2B9AD6"
                                          BlurRadius="9"
                                          ShadowDepth="0"
                                          Opacity="0.22" />
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse x:Name="loadingLogoHalo"
                         Width="118"
                         Height="118"
                         Fill="#2B9AD6"
                         Opacity="0.32"
                         IsHitTestVisible="False">
                    <Ellipse.Effect>
                        <BlurEffect Radius="32" />
                    </Ellipse.Effect>
                </Ellipse>
                <Border Width="124"
                        Height="124"
                        Background="Transparent"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect x:Name="loadingLogoGlowEffect"
                                          Color="#2B9AD6"
                                          BlurRadius="20"
                                          ShadowDepth="0"
                                          Opacity="0.24" />
                    </Border.Effect>
                    <Image x:Name="loadingLogoImage"
                           Width="124"
                           Height="124"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True" />
                </Border>
            </Grid>
            <StackPanel x:Name="loadingTextGroup">
                <TextBlock x:Name="loadingTitleText"
                           Text="LIG VS"
                           Foreground="#CCCCCC"
                           FontSize="32"
                           FontWeight="Black"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4">
                    <TextBlock.Effect>
                        <DropShadowEffect x:Name="loadingTitleGlowEffect"
                                          Color="#2B9AD6"
                                          BlurRadius="12"
                                          ShadowDepth="0"
                                          Opacity="0.2" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="loadingBrandText"
                           Text="by M&amp;S.Team3"
                           Foreground="#888888"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,14">
                    <TextBlock.Effect>
                        <DropShadowEffect x:Name="loadingBrandGlowEffect"
                                          Color="#2B9AD6"
                                          BlurRadius="7"
                                          ShadowDepth="0"
                                          Opacity="0.16" />
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>
            <TextBlock x:Name="statusText"
                       Text="LIG VS를 준비하는 중입니다..."
                       Foreground="#888888"
                       FontSize="12"
                       HorizontalAlignment="Center" />
            <ProgressBar x:Name="loadingProgress"
                         IsIndeterminate="True"
                         Width="220"
                         Height="4"
                         Margin="0,12,0,0"
                         Foreground="#0E70C0"
                         Background="#333333"
                         BorderThickness="0" />
            <Button x:Name="loadingRetryButton"
                    Visibility="Collapsed"
                    Content="다시 시도"
                    HorizontalAlignment="Center"
                    Margin="0,14,0,0"
                    Padding="14,5"
                    Click="OnRetryErrorClick" />
        </StackPanel>

        <Border x:Name="runtimeDiagnosticPanel"
                Visibility="Collapsed"
                Panel.ZIndex="20"
                VerticalAlignment="Top"
                Margin="8"
                Padding="10"
                Background="#3A1F22"
                BorderBrush="#B14A52"
                BorderThickness="1"
                CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="runtimeDiagnosticText"
                           VerticalAlignment="Center"
                           Foreground="#FFD7D9"
                           TextWrapping="Wrap"
                           MaxHeight="56" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <Button x:Name="runtimeDiagnosticDetailsButton"
                            Content="자세히"
                            Padding="9,3"
                            Margin="0,0,6,0"
                            Click="OnShowRuntimeDiagnosticDetailsClick" />
                    <Button x:Name="runtimeDiagnosticDismissButton"
                            Content="닫기"
                            Padding="9,3"
                            Click="OnDismissRuntimeDiagnosticClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="errorPanel"
              Visibility="Collapsed"
              Panel.ZIndex="30"
              Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:Name="errorText"
                     VerticalAlignment="Stretch"
                     HorizontalAlignment="Stretch"
                     Foreground="#F44747"
                     Background="#1E1E1E"
                     BorderBrush="#3C3C3C"
                     FontFamily="Consolas"
                     FontSize="12"
                     Padding="12"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     Text="" />
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button x:Name="errorRetryButton"
                        Content="다시 시도"
                        Padding="14,5"
                        Margin="0,0,8,0"
                        Click="OnRetryErrorClick" />
                <Button x:Name="errorDismissButton"
                        Content="오류 닫기"
                        Padding="14,5"
                        Click="OnDismissErrorClick" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
