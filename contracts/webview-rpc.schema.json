{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lig-vs.local/contracts/webview-rpc.schema.json",
  "title": "LIG VS WebView RPC operation registry",
  "type": "object",
  "required": ["schemaVersion", "protocolVersion", "shapes", "operations"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "protocolVersion": { "type": "integer", "minimum": 1 },
    "shapes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["fields"],
        "properties": {
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "enum": [
                    "string",
                    "number",
                    "boolean",
                    "object",
                    "array",
                    "stringArray",
                    "numberArray",
                    "booleanArray",
                    "objectArray",
                    "unknown"
                  ]
                },
                "required": { "type": "boolean" },
                "shape": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
                "values": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true }
              },
              "additionalProperties": false
            }
          },
          "allowAdditionalFields": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["service", "method", "kind", "client", "sidecar", "requestShape", "responseShape"],
        "properties": {
          "service": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*Service$" },
          "method": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
          "kind": { "enum": ["unary", "serverStream"] },
          "client": { "type": "boolean" },
          "sidecar": { "type": "boolean" },
          "fallback": { "enum": ["passive"] },
          "route": {
            "enum": [
              "settings", "account", "browser", "terminal", "task", "checkpoint", "hook",
              "scheduledAgent", "worktree", "mcp", "modelCatalog", "file", "instructionSettings",
              "uiWeb", "plugin", "stream"
            ]
          },
          "requestShape": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
          "responseShape": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
          "timeoutMs": { "type": "integer", "minimum": 1000 }
        },
        "allOf": [
          {
            "if": { "properties": { "sidecar": { "const": true } }, "required": ["sidecar"] },
            "then": { "required": ["route"] },
            "else": { "not": { "required": ["route"] } }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
